FROM oven/bun:1.3.13@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS bun
FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

# Hosted runner browser and font updates must not change visual baselines.
RUN curl --fail --location --output /tmp/chrome.deb https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_155.0.8059.39-1_amd64.deb \
    && curl --fail --location --output /tmp/edge.deb https://packages.microsoft.com/repos/edge/pool/main/m/microsoft-edge-stable/microsoft-edge-stable_155.0.4283.45-1_amd64.deb \
    && apt-get update \
    && apt-get install --yes --no-install-recommends /tmp/chrome.deb /tmp/edge.deb fonts-noto-cjk=1:20230817+repack1-3 \
    && rm -rf /var/lib/apt/lists/* /tmp/chrome.deb /tmp/edge.deb

COPY e2e/fonts.conf /etc/fonts/local.conf

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ENV CI=true
CMD ["bash", "-c", "bun run build && bun run e2e"]
